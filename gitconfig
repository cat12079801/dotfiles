[user]
  name = cat12079801
  email = cat12079801@gmail.com
[color]
  ui = true
[color "diff"]
  old = 166
  new = 035
  whitespace = "red reverse"
[color "diff-highlight"]
  oldNormal = 166
  oldHighlight = 214 052
  newNormal = 035
  newHighlight = 047 022
[alias]
  st = status
  tr = log --graph --pretty='format:%C(yellow)%h%Creset %s %Cgreen(%an)%Creset %Cred%d%Creset'
  br = branch -vv
  push = push -u
  mushi = update-index --assume-unchanged
  mushishinai = update-index --no-assume-unchanged
  # 今いるブランチにマージされている他のローカルブランチを削除する
  rmmerged = !"git branch --merged | grep -v '*' | xargs git branch -d"
[commit]
  template = ~/dotfiles/commit_template
[merge]
  ff = false
[pull]
  ff = only
[core]
  pager = delta
  quotepath = false
  editor = vim
[include]
  path = ~/.gitconfig.local
[push]
  default = simple
[diff]
  compactionHeuristic = true
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
[url "git@github.com:"]
  insteadOf = https://github.com/
[credential "https://github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !/opt/homebrew/bin/gh auth git-credential
